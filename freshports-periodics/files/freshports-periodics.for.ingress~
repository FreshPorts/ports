#
# This is a list of the periodic configuration settings for a FreshPorts
# ingress node. They can be added to /etc/periodic.conf.local or
# /etc/periodic.conf
#
# However, current installations have /etc/periodic.conf.local maintained
# via ansible. See roles/freshports-configuration-ingress/templates/periodic.conf.local-ingress.j2
#
# There are no periodic scripts pertaining to a FreshPorts web node.
#

# stuff mainly for freshports ingress nodes

everythreeminutes_output="/var/log/everythreeminutes.log"
hourly_output="/var/log/hourly.log"
daily_output="/var/log/daily.log"
fortnightly_output="/var/log/fortnightly.log"
weekly_output="/var/log/weekly.log"
monthly_output="/var/log/monthly.log"

daily_status_security_output="/var/log/daily_status_security.log"

# every 3 minutes
fp_check_for_git_commits_enable="YES"

# daily
fp_archive_messages_enable="YES"
fp_ports_tree_file_count_enable="YES"
fp_stats_daily_enable="YES"
fp_purge_old_password_tokens_enable="YES"
fp_daily_rendering_times_enable="YES"
fp_newusers_enable="YES"
fp_most_active_users_enable="YES"

# backup the repo tags for the ingress user
fp_dump_freshports_tags_enable="YES"

# hourly
fp_test_master_port_make_enable="YES"
fp_test_master_port_db_enable="YES"
fp_stats_hourly_enable="YES"
fp_missing_port_categories_enable="NO"

fp_check_repos_for_new_builds_enable="YES"
fp_refresh_package_imports_page_enable="YES"

fp_system_status_enable="YES"

fp_set_hour_flags_enable="YES"

# recreate category cache
fp_categories_rebuild_search="YES"

# refresh ABI database table based on FreeBSD project
fp_refresh_abi_enable="YES"

# nightly builds of watchers also watch
fp_watchers_also_watched_enable="YES"
fp_watchers_also_watched_watchgoose_url="{{ fp_watchers_also_watched_watchgoose_url }}"

fp_category_history_enable=YES

# Stuff only for production hosts

# reports
fp_send_security_notices_enable="YES"

fp_send_report_notices_daily_enable="YES"
fp_send_report_new_ports_daily_enable="YES"

fp_send_report_notices_fortnightly_enable="YES"
fp_send_report_new_ports_fortnightly_enable="YES"

fp_send_report_notices_weekly_enable="YES"
fp_send_report_new_ports_weekly_enable="YES"

fp_send_report_notices_monthly_enable="YES"
fp_send_report_new_ports_monthly_enable="YES"

fp_send_report_maintainer_daily_enable="YES"
